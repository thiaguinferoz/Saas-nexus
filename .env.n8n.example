N8N_HOST=n8n.seudominio.com.br
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.seudominio.com.br/
N8N_ENCRYPTION_KEY=troque-por-uma-chave-forte-e-permanente
NEXUS_API_INTERNAL_URL=http://api:8000

# Queue mode do próprio n8n. Use prefixo separado das streams da Nexus.
EXECUTIONS_MODE=queue
QUEUE_BULL_REDIS_HOST=redis
QUEUE_BULL_REDIS_PORT=6379
QUEUE_BULL_REDIS_PASSWORD=troque-esta-senha
QUEUE_BULL_REDIS_DB=1
QUEUE_BULL_REDIS_PREFIX=n8n

# PostgreSQL exclusivo do n8n; não use o banco/schema da aplicação Nexus.
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=n8n-postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=troque-esta-senha

N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_RUNNERS_ENABLED=true
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
